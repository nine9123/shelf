# Absolute path to the folder that holds your archives. Mounted READ-ONLY.
LIBRARY_PATH=/path/to/your/archives

# Where Shelf keeps its cache (index.db, covers/) and user.db.
# A host folder you control; created if missing. May be relative to this file.
CACHE_PATH=./cache

# Run as the user/group that owns your archives, so reads work and the cache
# ends up owned by you. Find them with:  id -u   and   id -g
PUID=1000
PGID=1000
