# Absolute path to the folder that holds your archives. Mounted READ-ONLY.
LIBRARY_PATH=/path/to/your/archives

# Where Shelf keeps its cache (index.db, covers/) and user.db.
# A host folder you control; created if missing. May be relative to this file.
CACHE_PATH=./cache

# Run as the user/group that owns your archives, so reads work and the cache
# ends up owned by you. Find them with:  id -u   and   id -g
PUID=1000
PGID=1000

# --- Semantic search (optional) ---
# Point at an Ollama server to enable natural-language ("by meaning") search.
# Leave OLLAMA_URL unset to disable the feature entirely.
#   ollama pull bge-m3     # multilingual embeddings (good for Japanese + English)
#   ollama pull llava      # vision model for cover captions; or 'moondream' for speed
# OLLAMA_URL=http://host.docker.internal:11434
# EMBED_MODEL=bge-m3
# VISION_MODEL=llava
# SEMANTIC_DELAY=0         # e.g. 500ms between archives to keep the GPU job low-priority
